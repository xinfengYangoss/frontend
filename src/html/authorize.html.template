<!DOCTYPE html>
<html lang="zh-Hans">
  <head>
    <title>CHENGVIN</title>
    <%= renderTemplate("_header.html.template") %>
    <%= renderTemplate("_style_base.html.template") %>
    <style>
      html {
        background-color: var(--primary-background-color, #fafafa);
        color: var(--primary-text-color, #212121);
      }
      @media (prefers-color-scheme: dark) {
        html {
          background-color: var(--primary-background-color, #111111);
          color: var(--primary-text-color, #e1e1e1);
        }
      }
      body {
        box-sizing: border-box;
        padding: 24px 0 32px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
      }
      .content {
        width: 100%;
        max-width: 400px;
        margin: 0 auto;
        padding: 0 16px;
        box-sizing: border-box;
      }

      .header {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 28px;
        padding-top: var(--safe-area-inset-top);
        text-align: center;
        max-width: 100%;
      }

      .header .brand-mark {
        display: block;
        width: 168px;
        max-width: 100%;
        height: auto;
        object-fit: contain;
      }

      .header .company-name {
        margin: 4px 0 0;
        font-size: 13px;
        line-height: 20px;
        letter-spacing: 0.04em;
        color: var(--secondary-text-color, #5f6368);
        max-width: 100%;
      }

      @media (prefers-color-scheme: dark) {
        .header .company-name {
          color: var(--secondary-text-color, #9aa0a6);
        }
      }
    </style>
  </head>
  <body>
    <div class="content">
      <div class="header">
        <img
          class="brand-mark"
          src="/static/images/chengvin/chengvin-mark.png"
          alt="CHENGVIN"
        />
        <div class="company-name">福建星启航信息科技有限公司</div>
      </div>
      <ha-authorize></ha-authorize>
    </div>
    <%= renderTemplate("_js_base.html.template") %>
    <%= renderTemplate("_preload_roboto.html.template") %>
    <%= renderTemplate("_script_loader.html.template") %>
    <script crossorigin="use-credentials">
      if (window.latestJS) {
        window.providersPromise = fetch("<%= hassUrl %>/auth/providers", {
          credentials: "same-origin",
        });
      }
    </script>
  </body>
</html>
