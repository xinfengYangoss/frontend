<!DOCTYPE html>
<html lang="zh-Hans">
  <head>
    <title>CHENGVIN</title>
    <%= renderTemplate("_header.html.template") %>
    <%= renderTemplate("_style_base.html.template") %>
    <style>
      html {
        background-color: var(--primary-background-color, #fafafa);
        color: var(--primary-text-color, #212121);
      }
      @media (prefers-color-scheme: dark) {
        html {
          background-color: var(--primary-background-color, #111111);
          color: var(--primary-text-color, #e1e1e1);
        }
      }
      body {
        height: auto;
        padding: 32px 0;
      }

      .content {
        max-width: min(560px, calc(100vw - var(--safe-area-inset-right, 0px) - var(--safe-area-inset-left, 0px)));
        margin: 0 auto;
        padding: 0 16px;
        box-sizing: content-box;
      }

      .header {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 10px;
        margin-bottom: 32px;
        margin-left: 32px;
        padding-top: var(--safe-area-inset-top);
      }

      .header .brand-mark {
        display: block;
        width: min(220px, 64vw);
        height: auto;
      }

      .header .company-name {
        font-size: 13px;
        line-height: 20px;
        letter-spacing: 0.06em;
        color: var(--secondary-text-color, #5f6368);
      }

      @media (prefers-color-scheme: dark) {
        .header .company-name {
          color: var(--secondary-text-color, #9aa0a6);
        }
      }
    </style>
  </head>
  <body id="particles">
    <div class="content">
      <div class="header">
        <img
          class="brand-mark"
          src="/static/images/chengvin/chengvin-mark.png"
          alt="CHENGVIN"
        />
        <div class="company-name">福建星启航信息科技有限公司</div>
      </div>
      <ha-onboarding></ha-onboarding>
    </div>
    <%= renderTemplate("_js_base.html.template") %>
    <%= renderTemplate("_preload_roboto.html.template") %>
    <%= renderTemplate("_script_loader.html.template") %>
    <script crossorigin="use-credentials">
      if (window.latestJS) {
        window.stepsPromise = fetch("<%= hassUrl %>/api/onboarding", {
          credentials: "same-origin",
        });
      }
    </script>
  </body>
</html>
